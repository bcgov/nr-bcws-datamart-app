{
    "version": "1.2.7",
    "name": "Wildfire DataMart",
    "viewer": {
        "type": "leaflet",
        "location": {
            "center": [
                -125,
                54
            ],
            "zoom": 6
        },
        "baseMap": "bc-basemap"
    },
    "layers": [
        {
            "type": "wms",
            "id": "fire-centres",
            "title": "BC Wildfire Fire Centres",
            "isVisible": true,
            "isQueryable": false,
            "opacity": 0.65,
            "serviceUrl": "https://openmaps.gov.bc.ca/geo/pub/wms",
            "layerName": "pub:WHSE_LEGAL_ADMIN_BOUNDARIES.DRP_MOF_FIRE_CENTRES_SP",
            "styleName": "3458"
        },
        {
            "type": "vector",
            "id": "weather-stations",
            "title": "Reporting Stations",
            "isVisible": true,
            "isQueryable": true,
            "useClustering": false,
            "isInternal": true,
            "titleAttribute": "STATION_NAME",
            "popupTemplate": "<div id='weatherStationPopup'>{{ window.weatherStationPopup( feature ) }}</div>",
            "opacity": 0.85,    
            "style": {
                "markerUrl": "/assets/smk/marker.svg",
                "markerSize": [ 20, 20 ],
                "markerOffset": [ 10, 10 ],
                "markerInline": true
            }
        }
    ],
    "tools": [
        {
            "type": "toolbar",
            "enabled": true
        },
        {
            "type": "list-menu",
            "enabled": false
        },
        {
            "type": "pan",
            "enabled": true
        },
        {
            "type": "zoom",
            "enabled": true
        },
        {
            "type": "about",
            "enabled": false
        },
        {
            "type": "layers",
            "enabled": false
        },
        {
            "type": "baseMaps",
            "enabled": false
        },
        {
            "type": "identify",
            "title": "Identify reporting stations",
            "enabled": true,
            "showWidget": true,
            "command": {
                "select": false,
                "nearBy": false
            },
            "radius": 20,
            "radiusUnit": "px",
            "tolerance": 12,
            "internalLayers": [
                {
                    "id": "search-area",
                    "style": {
                        "fillOpacity": 0,
                        "strokeOpacity": 0
                    }
                },
                {
                    "id": "search-border-1",
                    "style": {
                        "fillOpacity": 0,
                        "strokeOpacity": 0
                    }
                },
                {
                    "id": "search-border-2",
                    "style": {
                        "fillOpacity": 0,
                        "strokeOpacity": 0
                    }
                },
                {
                    "id": "location", 
                    "style": {
                        "fillOpacity": 0,
                        "strokeOpacity": 0,
                        "markerUrl": null
                    }
                }
            ]
        },
        {
            "type": "search",
            "enabled": true
        },
        {
            "type": "coordinate",
            "enabled": true
        },
        {
            "type": "markup",
            "enabled": false
        },
        {
            "type": "scale",
            "enabled": false
        },
        {
            "type": "minimap",
            "enabled": false
        },
        {
            "type": "directions",
            "enabled": false
        },
        {
            "type": "location",
            "enabled": false
        },
        {
            "type": "select-lasso",
            "title": "Select reporting stations by area",
            "enabled": true,
            "showWidget": true,
            "showPanel": false
        },
        {
            "type": "select",
            "enabled": true,
            "showWidget": false,
            "showPanel": false,
            "internalLayers": [
                {
                    "id": "highlight-point",
                    "style": {
                        "strokeColor": "green",
                        "strokeWidth": 30,
                        "strokeOpacity": 0.8,
                        "markerUrl": null,
                        "markerSize": null,
                        "markerOffset": null,
                        "shadowUrl": null,
                        "shadowSize": null
                    }
                }
            ]
        },
        {
            "type": "geomark",
            "enabled": false
        },
        {
            "type": "measure",
            "enabled": false
        }
    ]
}