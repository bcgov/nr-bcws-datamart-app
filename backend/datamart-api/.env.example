# Copy this file to backend/.env and fill in the values. backend/.env is git-ignored.
#
# Connection string of the Microsoft Fabric SQL analytics endpoint. The Authentication keyword
# decides how DAB signs in, so pick the style that matches where DAB runs:
#
#   Docker with Entra ID User Passwords (use this for local development environment):
#     Server=<name>.datawarehouse.fabric.microsoft.com;Database=<warehouse>;Authentication=Active Directory Password;User Id=<IDIR email>;Password=<IDIR password>;Encrypt=True;TrustServerCertificate=False;Command Timeout=240;Connect Timeout=60;
#
#   Azure Container Apps with the system-assigned managed identity (use this when deploying to cloud):
#     Server=<name>.datawarehouse.fabric.microsoft.com;Database=<warehouse>;Authentication=Active Directory Managed Identity;Encrypt=True;TrustServerCertificate=False;Command Timeout=240;Connect Timeout=60;
#    
#   Docker or Azure with a service principal:
#     Server=<name>.datawarehouse.fabric.microsoft.com;Database=<warehouse>;Authentication=Active Directory Service Principal;User ID=<client-id>;Password=<client-secret>;Encrypt=True;TrustServerCertificate=False;Command Timeout=240;Connect Timeout=60;
#
#   Local DAB CLI (uses your own sign-in, for example az login or a browser prompt):
#     Server=<name>.datawarehouse.fabric.microsoft.com;Database=<warehouse>;Authentication=Active Directory Interactive;Encrypt=True;TrustServerCertificate=False;Command Timeout=240;Connect Timeout=60;
FABRIC_SQL_CONNECTION_STRING=

# Connection string of the second Fabric database. It uses the same styles as above, with the
# Database value of the second warehouse. The entities of this database are in dab-config.db2.json.
FABRIC_SQL_CONNECTION_STRING_2=

# "development" or "production". Required when you run the DAB CLI directly (the Docker image
# defaults to production).
DAB_RUNTIME_MODE=development

# Browser origin allowed to call the API. Use * for local work.
DAB_CORS_ORIGIN=*
