{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.12/dab.draft.schema.json",
  "data-source": {
    "database-type": "dwsql",
    "connection-string": "@env('FABRIC_SQL_CONNECTION_STRING_2')",
    "options": {
      "set-session-context": false
    }
  },
  "entities": {
    "fire_centres": {
      "source": {
        "object": "dbo.FIRE_CENTRE_CODE_VW",
        "type": "table",
        "key-fields": [
          "FIRE_CENTRE_CODE"
        ]
      },
      "cache": {
        "enabled": true,
        "ttl-seconds": 86400
      },
      "permissions": [
        {
          "actions": [
            "read"
          ],
          "role": "anonymous"
        }
      ]
    },
    "fire_zones": {
      "source": {
        "object": "dbo.FIRE_ZONE_CODE_VW",
        "type": "table",
        "key-fields": [
          "FIRE_ZONE_CODE"
        ]
      },
      "cache": {
        "enabled": true,
        "ttl-seconds": 86400
      },
      "permissions": [
        {
          "actions": [
            "read"
          ],
          "role": "anonymous"
        }
      ]
    },
    "org_units": {
      "source": {
        "object": "dbo.FULL_ORG_UNIT_CURRENT_VW",
        "type": "table",
        "key-fields": [
          "ORG_UNIT_IDENTIFIER"
        ]
      },
      "cache": {
        "enabled": true,
        "ttl-seconds": 86400
      },
      "permissions": [
        {
          "actions": [
            "read"
          ],
          "role": "anonymous"
        }
      ]
    }
  }
}
