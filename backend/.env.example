# Copy this file to backend/.env and fill in the values. backend/.env is git-ignored.
#
# Connection string of the Microsoft Fabric SQL analytics endpoint. The Authentication keyword
# decides how DAB signs in, so pick the style that matches where DAB runs:
#
#   Local DAB CLI (uses your own sign-in, for example az login or a browser prompt):
#     Server=<name>.datawarehouse.fabric.microsoft.com;Database=<warehouse>;Authentication=Active Directory Interactive;Encrypt=True
#
#   Docker or Azure with a service principal:
#     Server=<name>.datawarehouse.fabric.microsoft.com;Database=<warehouse>;Authentication=Active Directory Service Principal;User ID=<client-id>;Password=<client-secret>;Encrypt=True
#
#   Azure Container Apps with the system-assigned managed identity:
#     Server=<name>.datawarehouse.fabric.microsoft.com;Database=<warehouse>;Authentication=Active Directory Managed Identity;Encrypt=True
FABRIC_SQL_CONNECTION_STRING=

# "development" or "production". Required when you run the DAB CLI directly (the Docker image
# defaults to production).
DAB_RUNTIME_MODE=development

# Browser origin allowed to call the API. Use * for local work.
DAB_CORS_ORIGIN=*
